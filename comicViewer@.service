[Unit]
Description=Http server for comic viewer
After=network.target

[Service]
User=%i
Type=simple
WorkingDirectory=/home/kzhang/github/comicViewer
ExecStart=/home/kzhang/github/comicViewer/.venv/bin/python3 /home/kzhang/github/comicViewer/src/main.py 127.0.0.1:9001
Restart=on-failure
RestartSec=30

ExecStop=/bin/kill -s QUIT $MAINPID

[Install]
WantedBy=multi-user.target